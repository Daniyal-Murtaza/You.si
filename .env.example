# Model provider. "openai" needs a key; "ollama" runs an open model locally with no account.
YOUSI_PROVIDER=openai
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4.1-mini

# Ollama (only if YOUSI_PROVIDER=ollama)
OLLAMA_MODEL=llama3.1:8b
OLLAMA_URL=http://localhost:11434

# Where your vault lives. Put this inside a folder you sync to your own cloud.
YOUSI_VAULT=./vaults/me

# Local embedding model (downloaded once, runs on your machine, free)
YOUSI_EMBED_MODEL=BAAI/bge-small-en-v1.5
YOUSI_LOG_LEVEL=INFO
